#!/usr/bin/env bash
# bin/agent-flywheel — the harness-agnostic entry point.
#
# The omp / Claude Code / Codex / Copilot adapters under adapters/ wire this
# project into hook systems those harnesses already have. Not every AI
# coding tool has hooks at all — this CLI is the fallback that works with
# ANY of them: it never assumes a particular "resume with a prompt" flag or
# event model, it just composes plain text on stdout that you pipe into
# whatever invocation mechanism your tool supports (a Makefile target, a
# git hook, a cron job, a keybinding, a custom script). See
# adapters/generic/README.md for worked wiring examples.
#
# Subcommands:
#   agent-flywheel nudge
#       Print the session-start maturity nudge, plus (when present) the
#       active GUARDRAILS.md titles and last LEVEL.md trend line. Feed it
#       into your harness's system prompt, AGENTS.md, or first-turn context
#       however it accepts one.
#
#   agent-flywheel prompt <session-end|periodic> [--session <path-or-id>]
#       Print the fully-assembled reflection prompt for the given trigger.
#       Pipe this into your harness's non-interactive/resume invocation, or
#       just tell your CURRENTLY RUNNING agent to follow it right now — no
#       process spawning needed for a manual, in-session trigger.
#
#   agent-flywheel reflect [--trigger session-end|periodic] [--session <path>] [--harness <name>] [--print]
#       THE universal manual/on-demand trigger, covering every case that
#       isn't "wait for the automatic hook":
#         - No --session given: prints the assembled prompt (same as
#           `prompt`) for you to run inline in your current live session —
#           this is the right move mid-session, or right before `/new`/
#           `/clear` if you don't trust the automatic hook to catch it.
#         - --session given: forces the SAME detached background pass an
#           automatic hook would have spawned, against that (usually just-
#           ended) session/transcript. Requires --harness unless exactly
#           one supported harness CLI is installed. --print shows the exact
#           command instead of running it.
#
#   agent-flywheel skill new <name> --root <dir> --description "<text>" [--force]
#   agent-flywheel skill list [--root <dir>]
#       Scaffold or enumerate skills — the CREATE / CHECK-EXISTING half of
#       the SKILL lifecycle stage. Omit --root on `list` to scan every
#       known root (see core/prompts/reference/skill-roots.txt).
#
#   agent-flywheel log [--lines N]
#       Tail the human-visible ledger (~/.agent-flywheel/LEARN.log) of what
#       every past reflection pass, on any harness, actually did.
#
#   agent-flywheel memory [--status|--guardrails|--level]
#       Print ~/.agent-flywheel/MEMORY.md (default), GUARDRAILS.md, or
#       LEVEL.md. --status reports which durable-memory backend (memorix /
#       claude-mem / flat-file) the reflection pass will use as primary —
#       see docs/prerequisites.md.
#
#   agent-flywheel doctor [--heal]
#       Verify the install actually works: FLYWHEEL_HOME synced, prompt
#       files present, log directory writable, and one --print dry-run
#       reflect per detected harness CLI. --heal auto-repairs on failure by
#       re-running install.sh once (re-sync + re-wire) and re-checking —
#       fixes a deleted prompt file, an unwired hook, or a partial sync.
#
#   agent-flywheel periodic-check --transcript <path> [--idle-seconds N] [--min-gap-seconds N]
#       Exit 0 ("fire") if a mid-session periodic reflection pass should
#       run now (transcript idle long enough AND the shared rate-limit
#       marker allows it), exit 1 ("skip") otherwise. Wire this into
#       whatever periodic/cron/watcher mechanism your harness or OS offers.
#   agent-flywheel periodic-mark
#       Record that a periodic reflection pass just ran (call this only
#       after successfully spawning one).
#
#   agent-flywheel autotune --config <path> --sessions-dir <path> [options]
#       Deterministic advisor-effectiveness auto-tune. Only meaningful for
#       harnesses with a second-model advisor/reviewer subsystem (omp
#       today); a no-op elsewhere.
#
#   agent-flywheel self-improve [--repo <path>] [--gate] [--trigger <pt>] [--mark]
#       META pass: print the prompt that makes the agent reflect on and
#       improve THIS loop itself (its prompts, adapters, guardrail
#       effectiveness, level trend, and next-skill curriculum) rather than
#       the last coding session. Pipe it into any harness, or follow it
#       inline in the current session. --repo points at the flywheel
#       checkout to assess (default: this one). --gate prints the prompt
#       only when the meta pass is DUE per the configured cadence
#       (config.env: mode every-session|gap|days|off, trigger
#       session-end|mid-session|both, gap-days, days-of-week), exiting 1
#       otherwise — for hook/cron wiring. --trigger names the calling point
#       (session-end default, or mid-session) so the gate can honor which
#       point the user allowed. --mark records that a pass just ran (resets
#       the gap clock). See core/prompts/self-improve.txt + config.env.example.
#
#   agent-flywheel version | help
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$BIN_DIR/.." && pwd)"
CORE_DIR="$ROOT_DIR/core"
SCRIPTS_DIR="$ROOT_DIR/scripts"
VERSION="0.2.0"
# shellcheck source=../core/lib.sh
source "$CORE_DIR/lib.sh"

usage() {
  # Slice the header comment block (line 2 through the line before the actual
  # `set -euo pipefail` line) rather than a hardcoded end line, so adding a
  # subcommand's doc block never desyncs `help`. Anchored to the exact set line
  # so a future `set -x` in a comment example can't truncate the output early.
  sed -n '2,/^set -euo pipefail/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'
}

cmd_nudge() {
  flywheel_render_nudge
}

cmd_prompt() {
  local trigger="${1:-}"
  shift || true
  local session=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) session="$2"; shift 2 ;;
      *) echo "unknown option: $1" >&2; return 2 ;;
    esac
  done
  case "$trigger" in
    session-end|periodic) ;;
    *) echo "usage: agent-flywheel prompt <session-end|periodic> [--session <path>]" >&2; return 2 ;;
  esac
  flywheel_build_prompt "$trigger" "$session"
}

# Resumes a session with a prompt for one harness — the single place this
# mapping lives, shared by --print (shows the shell-quoted command via
# printf %q, safe even though the prompt itself contains embedded
# newlines) and the real detached-spawn path, so they can never drift
# apart. Deliberately not a generic argv-array abstraction: bash 3.2 (the
# unmodified /bin/bash still shipped on stock macOS) has neither `mapfile`
# nor `readarray`, so this stays four plain case branches instead.
spawn_harness_resume() {
  local harness="$1" session="$2" prompt="$3" print_only="$4"
  local log
  log="$(flywheel_reflection_log)"
  case "$harness" in
    omp)
      if [ "$print_only" = "1" ]; then printf 'omp -p %q --resume %q\n' "$prompt" "$session"; return 0; fi
      AGENT_FLYWHEEL_PASS=1 nohup omp -p "$prompt" --resume "$session" >>"$log" 2>&1 &
      disown ;;
    claude-code)
      # NOT --resume <uuid>: Claude Code's `-p --resume <session-id>` fails with
      # "No conversation found" for a just-ended session, aborting reflection. The
      # prompt already embeds the session/transcript reference and reads it
      # directly, so a fresh --no-session-persistence pass is correct and robust.
      if [ "$print_only" = "1" ]; then printf 'claude -p %q --no-session-persistence\n' "$prompt"; return 0; fi
      AGENT_FLYWHEEL_PASS=1 nohup claude -p "$prompt" --no-session-persistence >>"$log" 2>&1 &
      disown ;;
    codex)
      if [ "$print_only" = "1" ]; then printf 'codex exec resume %q %q\n' "$session" "$prompt"; return 0; fi
      AGENT_FLYWHEEL_PASS=1 nohup codex exec resume "$session" "$prompt" >>"$log" 2>&1 &
      disown ;;
    copilot)
      if [ "$print_only" = "1" ]; then printf 'copilot --resume %q -p %q\n' "$session" "$prompt"; return 0; fi
      AGENT_FLYWHEEL_PASS=1 nohup copilot --resume "$session" -p "$prompt" >>"$log" 2>&1 &
      disown ;;
    *) echo "unknown harness: $harness (expected omp|claude-code|codex|copilot)" >&2; return 2 ;;
  esac
}

resolve_harness() {
  local explicit="$1"
  if [ -n "$explicit" ]; then
    printf '%s' "$explicit"
    return 0
  fi
  local found
  found="$(flywheel_detected_harness_clis || true)"
  local count
  count="$(printf '%s' "$found" | grep -c . || true)"
  if [ "$count" -eq 0 ]; then
    echo "no supported harness CLI found on PATH — pass --harness explicitly" >&2
    return 1
  fi
  if [ "$count" -gt 1 ]; then
    echo "multiple harness CLIs found — pass --harness explicitly, one of:" >&2
    printf '%s\n' "$found" | cut -d' ' -f1 >&2
    return 1
  fi
  printf '%s' "$found" | cut -d' ' -f1
}

cmd_reflect() {
  local trigger="session-end" session="" harness="" print_only=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --trigger) trigger="$2"; shift 2 ;;
      --session) session="$2"; shift 2 ;;
      --harness) harness="$2"; shift 2 ;;
      --print) print_only=1; shift ;;
      *) echo "unknown option: $1" >&2; return 2 ;;
    esac
  done

  if [ -z "$session" ]; then
    # No session to resume: print the prompt for the CURRENT live session to
    # follow inline — the manual/mid-session/"before /new" case.
    flywheel_build_prompt "$trigger" ""
    return 0
  fi

  harness="$(resolve_harness "$harness")" || return 1
  local prompt
  prompt="$(flywheel_build_prompt "$trigger" "$session")"

  if [ "$print_only" = "1" ]; then
    spawn_harness_resume "$harness" "$session" "$prompt" 1
    return 0
  fi

  spawn_harness_resume "$harness" "$session" "$prompt" 0
  echo "spawned reflection pass: harness=$harness trigger=$trigger session=$session (log: $(flywheel_reflection_log))"
}

cmd_skill() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    new)
      local name="${1:-}"
      shift || true
      node "$SCRIPTS_DIR/skill-scaffold.mjs" new "$name" "$@"
      ;;
    list)
      local root=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --root) root="$2"; shift 2 ;;
          *) echo "unknown option: $1" >&2; return 2 ;;
        esac
      done
      if [ -n "$root" ]; then
        node "$SCRIPTS_DIR/skill-scaffold.mjs" list --root "$root"
      else
        local r any=0
        while IFS= read -r r; do
          any=1
          echo "== $r =="
          node "$SCRIPTS_DIR/skill-scaffold.mjs" list --root "$r"
        done < <(flywheel_skill_roots)
        [ "$any" = "1" ] || echo "no known skill roots exist on this machine yet"
      fi
      ;;
    *) echo "usage: agent-flywheel skill <new|list> ..." >&2; return 2 ;;
  esac
}

cmd_log() {
  local lines=50
  while [ $# -gt 0 ]; do
    case "$1" in
      --lines) lines="$2"; shift 2 ;;
      *) echo "unknown option: $1" >&2; return 2 ;;
    esac
  done
  local file
  file="$(flywheel_learn_log)"
  if [ -f "$file" ]; then
    tail -n "$lines" "$file"
  else
    echo "$file does not exist yet — no reflection pass has run" >&2
  fi
}

cmd_memory() {
  local file
  case "${1:-}" in
    --guardrails) file="$(flywheel_guardrails_file)" ;;
    --level) file="$(flywheel_level_file)" ;;
    --status)
      # Report the active durable-memory backend (richest first) so a user can
      # see whether the reflection pass will write to memorix as primary or fall
      # back to the flat-file baseline. See docs/prerequisites.md.
      echo "durable-memory backends reachable (richest first; reflection uses the first as primary):"
      flywheel_memory_backend | sed 's/^/  - /'
      return 0 ;;
    "") file="$FLYWHEEL_HOME/MEMORY.md" ;;
    *) echo "unknown option: $1 (expected --status, --guardrails, or --level)" >&2; return 2 ;;
  esac
  if [ -f "$file" ]; then
    cat "$file"
  else
    echo "$file does not exist yet" >&2
  fi
}

cmd_doctor() {
  local heal=0 healed="${AGENT_FLYWHEEL_DOCTOR_HEALED:-0}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --heal) heal=1; shift ;;
      *) echo "unknown option: $1 (expected --heal)" >&2; return 2 ;;
    esac
  done
  local ok=1
  check() {
    if eval "$2"; then
      printf '\033[32m✓\033[0m %s\n' "$1"
    else
      printf '\033[31m✗\033[0m %s\n' "$1"
      ok=0
    fi
  }
  check "FLYWHEEL_HOME exists ($FLYWHEEL_HOME)" "[ -d '$FLYWHEEL_HOME' ]"
  check "core prompts present" "[ -f '$(flywheel_prompt_file)' ] && [ -f '$(flywheel_periodic_prompt_file)' ] && [ -f '$(flywheel_nudge_file)' ]"
  check "reference docs present" "[ -f '$CORE_DIR/prompts/reference/skill-roots.txt' ] && [ -f '$CORE_DIR/prompts/reference/skill-authoring.txt' ] && [ -f '$CORE_DIR/prompts/reference/guardrails-format.txt' ] && [ -f '$CORE_DIR/prompts/reference/level-rubric.txt' ] && [ -f '$CORE_DIR/prompts/reference/project-rules.txt' ]"
  check "self-improve prompt present" "[ -f '$(flywheel_self_improve_prompt_file)' ]"
  check "node available (needed by scripts/*.mjs)" "command -v node >/dev/null 2>&1"
  check "\$FLYWHEEL_HOME is writable" "mkdir -p '$FLYWHEEL_HOME' && touch '$FLYWHEEL_HOME/.doctor-write-test' && rm -f '$FLYWHEEL_HOME/.doctor-write-test'"

  # Informational, never a failure: report the durable-memory backend the
  # reflection pass will treat as primary (memorix/claude-mem when reachable,
  # flat-file baseline otherwise — see docs/prerequisites.md). The flat-file
  # baseline always works, so this can't fail; it just tells the user which
  # store is active.
  local mem_primary
  mem_primary="$(flywheel_memory_backend | head -1 | cut -d' ' -f1)"
  printf '\033[34mℹ\033[0m durable-memory primary: %s (agent-flywheel memory --status for all)\n' "$mem_primary"

  local found any=0
  found="$(flywheel_detected_harness_clis || true)"
  while IFS=' ' read -r name _bin; do
    [ -n "$name" ] || continue
    any=1
    check "reflect --print dry-run for $name" "\"$BIN_DIR/agent-flywheel\" reflect --harness '$name' --session /tmp/agent-flywheel-doctor-fake-session --print >/dev/null"
  done <<< "$found"
  [ "$any" = "1" ] || printf '\033[33m⚠\033[0m no harness CLI detected on PATH — install.sh wiring can'"'"'t be dry-run tested here, only manual invocation\n'

  echo
  if [ "$ok" = "1" ]; then
    printf '\033[32mall checks passed\033[0m\n'
    return 0
  fi

  printf '\033[31msome checks failed — see above\033[0m\n'
  # Auto-heal: re-run install.sh once to re-sync the managed tree and re-wire
  # every detected harness, then re-check. This repairs the common drift cases
  # (a deleted prompt file, a hook unwired by a settings.json edit, a partial
  # sync) without the user reasoning about which step broke. Guarded by an env
  # flag so the single recursive re-check can never loop.
  if [ "$heal" = "1" ] && [ "$healed" != "1" ]; then
    # Heal from the recorded source checkout when doctor is running out of the
    # installed home (ROOT_DIR == FLYWHEEL_HOME, nothing to re-sync from itself);
    # otherwise heal from this checkout directly.
    local heal_src="$ROOT_DIR"
    if [ -f "$FLYWHEEL_HOME/.source-checkout" ]; then
      local recorded
      recorded="$(cat "$FLYWHEEL_HOME/.source-checkout" 2>/dev/null || true)"
      # SECURITY: .source-checkout designates a script we're about to EXECUTE. A
      # state file must not be able to point heal at an attacker-controlled
      # install.sh. Only trust a recorded checkout that (a) exists with an
      # install.sh and (b) is owned by us and not group/other-writable — both the
      # dir and the script. Otherwise fall back to this checkout ($ROOT_DIR).
      if [ -n "$recorded" ] && [ -x "$recorded/install.sh" ] \
         && flywheel_path_trusted "$recorded" && flywheel_path_trusted "$recorded/install.sh"; then
        heal_src="$recorded"
      elif [ -n "$recorded" ]; then
        printf '\033[33m⚠\033[0m recorded .source-checkout (%s) is missing, not owned by you, or group/other-writable — refusing to execute its install.sh; healing from this checkout instead\n' "$recorded"
      fi
    fi
    if [ -x "$heal_src/install.sh" ]; then
      # NOTE (plugin channel): if this CLI is the plugin copy, heal re-runs the
      # plugin's install.sh, which also wires settings.json — adding a second
      # Claude Code registration on top of the plugin's own hooks. That is
      # bounded: the per-session close-out lock in session-end.sh dedups to a
      # single reflection regardless. Heal only fires on genuine file loss (a
      # healthy plugin passes doctor and never reaches here).
      echo
      printf '\033[34m→\033[0m self-heal: re-running %s/install.sh\n' "$heal_src"
      if [ "$heal_src" = "$FLYWHEEL_HOME" ]; then
        printf '\033[33m⚠\033[0m heal source is the install home itself — re-wiring only; deleted managed files cannot be restored without the original checkout (run install.sh from it)\n'
      fi
      AGENT_FLYWHEEL_HOME="$FLYWHEEL_HOME" "$heal_src/install.sh" --home "$FLYWHEEL_HOME" || true
      echo
      printf '\033[34m→\033[0m self-heal: re-checking\n'
      AGENT_FLYWHEEL_DOCTOR_HEALED=1 "$BIN_DIR/agent-flywheel" doctor
      return $?
    fi
    printf '\033[33m⚠\033[0m self-heal requested but no usable install.sh found (checkout moved or deleted?) — reinstall from the repo\n'
  fi
  [ "$heal" = "1" ] && [ "$healed" = "1" ] && printf '\033[33m⚠\033[0m self-heal ran but checks still fail — see the failures above\n'
  return 1
}

cmd_periodic_check() {
  node "$SCRIPTS_DIR/idle-gap.mjs" check "$@"
}

cmd_periodic_mark() {
  node "$SCRIPTS_DIR/idle-gap.mjs" mark "$@"
}

cmd_autotune() {
  node "$SCRIPTS_DIR/advisor-autotune.mjs" "$@"
}

cmd_self_improve() {
  local repo="$ROOT_DIR" gate=0 mark=0 trigger="session-end"
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --trigger) trigger="$2"; shift 2 ;;
      --gate) gate=1; shift ;;
      --mark) mark=1; shift ;;
      --print) shift ;; # accepted for symmetry; the prompt is always printed
      *) echo "unknown option: $1" >&2; return 2 ;;
    esac
  done
  # --gate honors the configured cadence (mode/trigger/days/gap in config.env).
  # Without --gate the meta pass is always printed — the manual on-demand path.
  if [ "$gate" = "1" ]; then
    # Atomically serialize the due-check + mark so two sessions ending near-
    # simultaneously (many terminals — the exact case the cadence floor exists
    # for) can't BOTH read a stale marker, both pass the gate, and both run the
    # expensive meta pass (whose step 0 heal would race a concurrent install
    # rsync). mkdir is atomic; a lock orphaned by a crash is cleared after 60s.
    mkdir -p "$FLYWHEEL_HOME" 2>/dev/null || true
    local si_lock="$FLYWHEEL_HOME/.self-improve.lock"
    if ! mkdir "$si_lock" 2>/dev/null; then
      if [ -d "$si_lock" ] && [ -z "$(find "$si_lock" -maxdepth 0 -mmin -1 2>/dev/null)" ]; then
        rmdir "$si_lock" 2>/dev/null || true
        mkdir "$si_lock" 2>/dev/null || { echo "self-improve: could not acquire gate lock — skipping" >&2; return 1; }
      else
        echo "self-improve: another gate is in progress — skipping" >&2
        return 1
      fi
    fi
    if ! flywheel_self_improve_due "$trigger"; then
      rmdir "$si_lock" 2>/dev/null || true
      echo "self-improve not due now per configured cadence (trigger=$trigger; see config.env) — skipping" >&2
      return 1
    fi
    [ "$mark" = "1" ] && flywheel_mark_self_improve_ran
    rmdir "$si_lock" 2>/dev/null || true
  fi
  # The meta pass reads files (the flywheel checkout + ~/.agent-flywheel/*), not
  # a resumable transcript — so this prints the assembled prompt for the current
  # agent to follow inline or to pipe into any harness's headless invocation.
  # There is deliberately no --resume spawn here: there is no prior session to
  # resume, the subject is the loop itself.
  flywheel_build_prompt self-improve "$repo" "The agent-flywheel repo checkout to assess is" "at"
  # The gated path already marked atomically under the lock above; only the
  # ungated manual `self-improve --mark` path needs to record the run here.
  [ "$mark" = "1" ] && [ "$gate" = "0" ] && flywheel_mark_self_improve_ran
  return 0
}

main() {
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    nudge) cmd_nudge "$@" ;;
    prompt) cmd_prompt "$@" ;;
    reflect) cmd_reflect "$@" ;;
    skill) cmd_skill "$@" ;;
    log) cmd_log "$@" ;;
    memory) cmd_memory "$@" ;;
    doctor) cmd_doctor "$@" ;;
    periodic-check) cmd_periodic_check "$@" ;;
    periodic-mark) cmd_periodic_mark "$@" ;;
    autotune) cmd_autotune "$@" ;;
    self-improve) cmd_self_improve "$@" ;;
    version|--version|-v) echo "agent-flywheel $VERSION" ;;
    help|--help|-h) usage ;;
    *) echo "unknown subcommand: $sub" >&2; usage >&2; return 2 ;;
  esac
}

main "$@"
