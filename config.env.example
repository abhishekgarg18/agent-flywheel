# agent-flywheel configuration.
#
# install.sh seeds this to ~/.agent-flywheel/config.env (and never overwrites an
# existing one on re-run). Edit that copy. Plain KEY=VALUE lines, no quoting
# needed. Precedence, highest first:
#   1. an env var of the same name set in the shell for a single run
#   2. this file
#   3. the built-in default shown after each key below
#
# Verify what's active any time:
#   agent-flywheel memory --status                 # which memory backend is primary
#   agent-flywheel self-improve --gate; echo $?    # 0 = meta pass is due now, 1 = not
# Values take effect on the next session / next `agent-flywheel` invocation.

# ─────────────────────────────────────────────────────────────────────────────
# META self-improvement pass — the loop reflecting on and improving ITSELF
# (its prompts, adapters, guardrail effectiveness, level trend, next-skill
# curriculum). This is the expensive one, so it is gated. Tune it here.
# ─────────────────────────────────────────────────────────────────────────────

# WHEN it may auto-run. One of:
#   every-session  every eligible trigger (see TRIGGER) — most aggressive
#   gap            at most once per SELF_IMPROVE_GAP_DAYS (default, recommended)
#   days           only on the weekdays in SELF_IMPROVE_DAYS
#   off            never auto-run; manual `agent-flywheel self-improve` only
AGENT_FLYWHEEL_SELF_IMPROVE_MODE=gap

# For mode=gap: minimum days between auto meta passes.
AGENT_FLYWHEEL_SELF_IMPROVE_GAP_DAYS=7

# For mode=days: comma list of weekdays. Names (Mon..Sun, any case) or numbers
# (1=Mon .. 7=Sun). Example: Mon,Thu  or  1,4
AGENT_FLYWHEEL_SELF_IMPROVE_DAYS=Sat

# WHICH trigger point(s) may run the meta pass:
#   session-end   at session close-out (default)
#   mid-session   during the periodic idle checkpoint
#   both          either point
AGENT_FLYWHEEL_SELF_IMPROVE_TRIGGER=session-end

# ─────────────────────────────────────────────────────────────────────────────
# Session-start primers — extra context injected with the first-turn nudge.
# Both default ON when the resource is present; set to 0 to suppress.
# ─────────────────────────────────────────────────────────────────────────────

# Surface the most recent handoff file so a new session resumes prior work.
AGENT_FLYWHEEL_NUDGE_HANDOFF=1
# Where handoff files live (newest *.md is surfaced).
AGENT_FLYWHEEL_HANDOFFS_DIR=~/.claude/handoffs
# Inject the memorix Workset (per-project context brief: start-here files,
# reliable memories, cautions, current git facts) when the memorix CLI is present.
AGENT_FLYWHEEL_NUDGE_MEMORIX=1

# ─────────────────────────────────────────────────────────────────────────────
# Periodic mid-session checkpoint — the lightweight reflection that runs while a
# long-lived session sits idle (distinct from the close-out reflection, which
# always runs on every session end and is not gated here). These are read by the
# Claude Code periodic-watcher and the omp extension alike.
# ─────────────────────────────────────────────────────────────────────────────

# How often the idle check runs, in seconds (default 900 = 15 min).
AGENT_FLYWHEEL_PERIODIC_CHECK_SECONDS=900

# How long the transcript must be untouched before a checkpoint fires (default 300 = 5 min).
AGENT_FLYWHEEL_IDLE_SECONDS=300

# Floor between actual periodic passes, shared across every harness on this
# machine so many open terminals don't multiply cost (default 7200 = 2 h).
AGENT_FLYWHEEL_MIN_PERIODIC_GAP_SECONDS=7200
